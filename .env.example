# ==============================================================================
# Firebase Admin SDK (서버 / Vercel / 데스크톱 백엔드용)
# 로컬 개발 시 프로젝트 루트의 eduflow-db-b44f3-5692e5dea8c3.json 을 우선 사용하며,
# Vercel 등 배포 환경에서 로컬 JSON이 없을 경우 아래 환경변수를 자동으로 읽어 초기화합니다.
# ==============================================================================
FIREBASE_PROJECT_ID=eduflow-db-b44f3
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@eduflow-db-b44f3.iam.gserviceaccount.com
# 주의: Vercel 환경변수 입력 시 실제 줄바꿈 또는 \n 이스케이프 문자열 모두 지원됩니다.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=eduflow-db-b44f3.firebasestorage.app

# ==============================================================================
# Firebase Web App Config (EduFlow Mobile PWA 클라이언트용)
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=eduflow-db-b44f3.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eduflow-db-b44f3
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=eduflow-db-b44f3.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
