/* ============================================================================
   EduFlow Slate Workstation — Stitch Design System Theme
   File: ui/styles/theme.qss
   Stitch Tokens: Slate #0F172A (text/nav) · Canvas #F8F9FF (workspace)
                  Primary Blue #004AC6 · Border #E2E8F0
   Radius: controls 8px · cards 12px
   Architecture: High-contrast Dark Slate Navigation + Glare-reduced Workspace
   ============================================================================ */

* {
    font-family: "Inter", "Pretendard", "Segoe UI Variable Display", "Segoe UI", -apple-system, sans-serif;
    font-size: 13px;
    outline: none;
}

/* ----------------------------------------------------------------------------
   1. Window & Dialog Backgrounds
   ---------------------------------------------------------------------------- */
QMainWindow {
    background-color: #0f172a;
}

QDialog {
    background-color: #f8fafc;
    color: #0f172a;
}

QWidget {
    color: #0f172a;
}

/* ----------------------------------------------------------------------------
   1-1. Floating Tooltips (Instrument Grade, Monoline Border)
   ---------------------------------------------------------------------------- */
QToolTip {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ----------------------------------------------------------------------------
   2. Dark Navigation Shell (Left Rail #0F172A)
   ---------------------------------------------------------------------------- */
QFrame#SidebarContainer {
    background-color: #0f172a;
    border-right: 1px solid #1e293b;
}

QPushButton#SidebarToggleBtn {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
    font-size: 14px;
    font-weight: 600;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    text-align: center;
}

QPushButton#SidebarToggleBtn:hover {
    background-color: #004ac6;
    border-color: #2f6fe0;
    color: #ffffff;
}

QLabel#SidebarBrandTitle {
    color: #f8fafc;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 2px 0px;
}

QLabel#SidebarBrandSubtitle {
    color: #64748b;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 0px 0px 6px 0px;
}

QLabel#SidebarSectionLabel {
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 8px 8px 4px 8px;
}

QListWidget#SidebarNavList {
    background-color: transparent;
    border: none;
    padding: 4px 0px;
    outline: none;
}

QListWidget#SidebarNavList::item {
    background-color: transparent;
    color: #94a3b8;
    border-radius: 8px;
    padding: 9px 12px;
    margin-bottom: 2px;
    font-size: 13px;
    font-weight: 500;
}

QListWidget#SidebarNavList[collapsed="true"] {
    padding: 4px 0px;
}

QListWidget#SidebarNavList[collapsed="true"]::item {
    padding: 9px 0px;
    font-size: 13px;
    text-align: center;
}

QListWidget#SidebarNavList::item:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: #f8fafc;
}

QListWidget#SidebarNavList::item:selected {
    background-color: #004ac6;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#SidebarTrayButton {
    background-color: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    min-height: 34px;
}

QPushButton#SidebarTrayButton[collapsed="true"] {
    padding: 8px 0px;
    text-align: center;
    font-size: 13px;
}

QPushButton#SidebarTrayButton:hover {
    background-color: #334155;
    border-color: #475569;
    color: #f8fafc;
}

/* ----------------------------------------------------------------------------
   3. Workspace Canvas & Header
   ---------------------------------------------------------------------------- */
QFrame#WorkspaceContainer {
    background-color: #f8f9ff;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QFrame#TopHeaderBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

QLabel#PageHeaderTitle {
    color: #0f172a;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
}

QLabel#PageHeaderDesc {
    color: #64748b;
    font-size: 12px;
    font-weight: 400;
}

QLabel#AiModeBadge {
    background-color: #eef3fd;
    color: #003ea8;
    border: 1px solid #c7d7f5;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

QStackedWidget#MainStackedWidget {
    background-color: #f8f9ff;
}

/* ----------------------------------------------------------------------------
   4. Surface Cards (HoverZoomCard, GroupBox & Info Banners)
   ---------------------------------------------------------------------------- */
HoverZoomCard, QFrame[role="hoverZoomCard"] {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

QLabel#HoverCardTitle {
    color: #0f172a;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 2px 0px;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    margin-top: 10px;
    padding: 16px 14px 14px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #0f172a;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 2px 8px;
    background-color: #ffffff;
    border-radius: 4px;
    color: #0f172a;
    font-weight: 600;
}

QPushButton#CardMaxButton, QPushButton[role="cardMax"] {
    background-color: #f8fafc;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 500;
    min-height: 24px;
}

QPushButton#CardMaxButton:hover, QPushButton[role="cardMax"]:hover {
    background-color: #eef3fd;
    color: #004ac6;
    border-color: #c7d7f5;
}

QPushButton#CardMaxButton:checked, QPushButton[role="cardMax"]:checked {
    background-color: #eef3fd;
    color: #004ac6;
    border-color: #2f6fe0;
    font-weight: 600;
}

/* Banners & Status Callouts */
QLabel[role="infoBanner"] {
    background-color: #eef3fd;
    color: #00338a;
    border: 1px solid #dde7fa;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 500;
}

QLabel[role="mutedText"] {
    color: #64748b;
    font-size: 12px;
}

/* Stitch 3-Stage Stepper & Field Labels */
QFrame[role="stepperBar"] {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

QFrame[role="stageBox"] {
    background-color: #f8f9ff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

QFrame[role="stageBoxActive"] {
    background-color: #eef3fd;
    border: 1px solid #c7d7f5;
    border-radius: 8px;
}

QFrame[role="stageBoxDone"] {
    background-color: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 8px;
}

QLabel[role="stageNumber"] {
    background-color: #eef3fd;
    color: #004ac6;
    border: 1px solid #c7d7f5;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
}

QLabel[role="stageTitle"] {
    color: #0f172a;
    font-size: 13px;
    font-weight: 600;
}

QLabel[role="fieldLabel"] {
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0px 0px 2px 2px;
}

QLabel[role="engineBadge"] {
    background-color: #f8f9ff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
}

QLabel[role="stageBadge"] {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 500;
}

QLabel[role="stageBadgeActive"] {
    background-color: #004ac6;
    color: #ffffff;
    border: 1px solid #003ea8;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="stageBadgeDone"] {
    background-color: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* ----------------------------------------------------------------------------
   5. Sub-Tabs (QTabWidget)
   ---------------------------------------------------------------------------- */
QTabWidget::pane {
    background-color: transparent;
    border: none;
    margin-top: 4px;
}

QTabBar::tab {
    background-color: #e2e8f0;
    color: #475569;
    border: none;
    border-radius: 8px;
    padding: 7px 14px;
    margin-right: 4px;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: #cbd5e1;
    color: #0f172a;
}

QTabBar::tab:selected {
    background-color: #004ac6;
    color: #ffffff;
    font-weight: 600;
}

/* ----------------------------------------------------------------------------
   6. Buttons & Interactive Controls (Precision Button Hierarchy)
   ---------------------------------------------------------------------------- */
/* Default / Subtle Button */
QPushButton {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
}

QPushButton:pressed {
    background-color: #f1f5f9;
}

QPushButton:disabled {
    background-color: #f8fafc;
    color: #94a3b8;
    border-color: #e2e8f0;
}

/* Primary Action Button (#004ac6) */
QPushButton[role="primary"] {
    background-color: #004ac6;
    color: #ffffff;
    border: 1px solid #003ea8;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton[role="primary"]:hover {
    background-color: #003ea8;
    border-color: #00338a;
}

QPushButton[role="primary"]:pressed {
    background-color: #00338a;
}

QPushButton[role="primary"]:disabled {
    background-color: #9bb5e6;
    border-color: #9bb5e6;
    color: #ffffff;
}

/* Secondary Button */
QPushButton[role="secondary"] {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-weight: 500;
}

QPushButton[role="secondary"]:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
}

QPushButton[role="secondary"]:pressed {
    background-color: #f1f5f9;
}

/* Outline / Subtle Ghost Button */
QPushButton[role="outline"] {
    background-color: transparent;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-weight: 500;
}

QPushButton[role="outline"]:hover {
    background-color: #f1f5f9;
    color: #0f172a;
    border-color: #94a3b8;
}

/* Success Button (#10B981) */
QPushButton[role="success"] {
    background-color: #10b981;
    color: #ffffff;
    border: 1px solid #059669;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton[role="success"]:hover {
    background-color: #059669;
    border-color: #047857;
}

QPushButton[role="success"]:pressed {
    background-color: #047857;
}

/* Danger / Stop Button (#DC2626 or Outline) */
QPushButton[role="danger"] {
    background-color: #ffffff;
    color: #dc2626;
    border: 1px solid #fecaca;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton[role="danger"]:hover {
    background-color: #fef2f2;
    border-color: #f87171;
}

QPushButton[role="danger"]:pressed {
    background-color: #fee2e2;
}

QPushButton[role="dangerSolid"] {
    background-color: #dc2626;
    color: #ffffff;
    border: 1px solid #b91c1c;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton[role="dangerSolid"]:hover {
    background-color: #b91c1c;
}

/* Warning / Undo Outline Button */
QPushButton[role="warningOutline"] {
    background-color: #fffbeb;
    color: #92400e;
    border: 1px solid #fde68a;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton[role="warningOutline"]:hover {
    background-color: #fef3c7;
    border-color: #f59e0b;
}

/* Slate Utility Button */
QPushButton[role="slate"] {
    background-color: #334155;
    color: #f8fafc;
    border: 1px solid #475569;
    border-radius: 8px;
    font-weight: 500;
}

QPushButton[role="slate"]:hover {
    background-color: #475569;
}

/* ----------------------------------------------------------------------------
   7. Form Inputs (QLineEdit, QComboBox, QSpinBox)
   ---------------------------------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 32px;
    height: 32px;
    font-size: 13px;
    selection-background-color: #eef3fd;
    selection-color: #003ea8;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border-color: #94a3b8;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #004ac6;
    background-color: #ffffff;
}

QLineEdit:read-only {
    background-color: #f8fafc;
    color: #64748b;
    border-color: #e2e8f0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #e2e8f0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #f8fafc;
}

QComboBox::drop-down:hover {
    background-color: #f1f5f9;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #64748b;
    margin-right: 1px;
}

QComboBox QAbstractItemView {
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background-color: #ffffff;
    selection-background-color: #eef3fd;
    selection-color: #003ea8;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
}

QTextEdit, QListWidget {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #eef3fd;
    selection-color: #003ea8;
}

QTextEdit:focus, QListWidget:focus {
    border: 1px solid #004ac6;
}

/* Checkbox (Square 14px look) */
QCheckBox {
    spacing: 6px;
    color: #0f172a;
    font-size: 12px;
    font-weight: 500;
    min-height: 24px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #cbd5e1;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #94a3b8;
}

QCheckBox::indicator:checked {
    background-color: #004ac6;
    border-color: #004ac6;
    image: none;
}

/* ----------------------------------------------------------------------------
   8. Data Table (Instrument-Grade Desktop Grid)
   ---------------------------------------------------------------------------- */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8f9ff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    selection-background-color: #eef3fd;
    selection-color: #003ea8;
}

QTableWidget::item {
    padding: 4px 8px;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    border-right: 1px solid #f1f5f9;
    padding: 6px 8px;
}

QTableCornerButton::section {
    background-color: #f8fafc;
    border: none;
    border-bottom: 1px solid #e2e8f0;
}

/* Splitter Handle */
QSplitter::handle {
    background-color: #e2e8f0;
    border-radius: 2px;
}

QSplitter::handle:horizontal {
    width: 5px;
    margin: 4px 2px;
}

QSplitter::handle:vertical {
    height: 5px;
    margin: 2px 4px;
}

QSplitter::handle:hover {
    background-color: #004ac6;
}

/* ----------------------------------------------------------------------------
   9. Bottom Status Bar & Log Drawer
   ---------------------------------------------------------------------------- */
QFrame#BottomStatusContainer {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
}

QLabel#StatusTaskBadge {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#StatusSingleLineLog {
    color: #64748b;
    font-size: 12px;
    padding: 0 6px;
}

QProgressBar#ModernProgressBar {
    background-color: #e2e8f0;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
    text-align: center;
}

QProgressBar#ModernProgressBar::chunk {
    background-color: #004ac6;
    border-radius: 4px;
}

QFrame#LogConsoleDrawer {
    background-color: #0f172a;
    border-top: 1px solid #1e293b;
}

QTextEdit#DarkLogConsole {
    background-color: #0f172a;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 8px 10px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

/* ----------------------------------------------------------------------------
   10. Modals & Dialogs
   ---------------------------------------------------------------------------- */
QDialog#ManualLlmModal, QDialog#RuleEditModal {
    background-color: #f8fafc;
}

QFrame#ModalHeaderCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

QTextEdit#PromptCodeBox {
    background-color: #0f172a;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 10px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

QTextEdit#WebAiInputBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
}

QTextEdit#WebAiInputBox:focus {
    border: 1px solid #004ac6;
}

QTextEdit#ParsedPreviewBox {
    background-color: #f0fdf4;
    color: #14532d;
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    padding: 10px;
    font-size: 12px;
}

/* ----------------------------------------------------------------------------
   11. Scrollbars (Minimal Desktop Style)
   ---------------------------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
