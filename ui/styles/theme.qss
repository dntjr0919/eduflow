/* ============================================================================
   EduFlow Slate Workstation — Stitch Design System Theme
   File: ui/styles/theme.qss
   Stitch Tokens: Deep Midnight #0B1329 (nav shell) · Canvas #F8FAFC / #F8F9FF
                  Primary Blue #0B4DCB (hover #0052CC, pressed #093CA3)
                  Secondary Cyan #0284C7 · Border #E2E8F0 / #CBD5E1
   Radius: controls 6px · subCards/tables 8px · cards 10px~12px
   Architecture: High-contrast Deep Midnight Navigation + Glare-reduced Workspace
   ============================================================================ */

* {
    font-family: "Inter", "Pretendard", "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 13px;
    outline: none;
}

/* ----------------------------------------------------------------------------
   1. Window & Dialog Backgrounds
   ---------------------------------------------------------------------------- */
QMainWindow {
    background-color: #0B1329;
}

QDialog {
    background-color: #F8FAFC;
    color: #0F172A;
}

QWidget {
    color: #0F172A;
}

/* ----------------------------------------------------------------------------
   1-1. Floating Tooltips (Instrument Grade, Monoline Border)
   ---------------------------------------------------------------------------- */
QToolTip {
    background-color: #0B1329;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ----------------------------------------------------------------------------
   2. Dark Navigation Shell (Deep Midnight #0B1329)
   ---------------------------------------------------------------------------- */
QFrame#SidebarContainer {
    background-color: #0B1329;
    border-right: 1px solid #1E293B;
}

QPushButton#SidebarToggleBtn {
    background-color: transparent;
    color: #94A3B8;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    font-size: 15px;
    font-weight: 600;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    text-align: center;
}

QPushButton#SidebarToggleBtn:hover {
    background-color: #1E293B;
    border-color: #334155;
    color: #FFFFFF;
}

QFrame#SidebarBrandHeader {
    background-color: transparent;
    border: none;
    padding-bottom: 4px;
}

QPushButton#SidebarBrandLogoBadge {
    background-color: #0B4DCB;
    border: none;
    border-radius: 8px;
    padding: 0px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}

QPushButton#SidebarBrandLogoBadge:hover {
    background-color: #1D4ED8;
}

QLabel#SidebarBrandTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.02em;
    padding: 0px;
    margin: 0px;
}

QLabel#SidebarBrandSubtitle {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 0px;
    margin: 0px;
}

QLabel#SidebarSectionLabel {
    color: #475569;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 6px 10px 2px 10px;
}

QListWidget#SidebarNavList {
    background-color: transparent;
    border: none;
    padding: 4px 0px;
    outline: none;
}

QListWidget#SidebarNavList:focus {
    border: none;
    outline: none;
}

QListWidget#SidebarNavList::item {
    background-color: transparent;
    color: #94A3B8;
    border-radius: 8px;
    padding: 9px 12px;
    margin-bottom: 2px;
    font-size: 13px;
    font-weight: 500;
}

QListWidget#SidebarNavList[collapsed="true"] {
    padding: 4px 0px;
}

QListWidget#SidebarNavList[collapsed="true"]::item {
    padding: 9px 0px;
    font-size: 13px;
    text-align: center;
}

QListWidget#SidebarNavList::item:hover {
    background-color: #0F172A;
    color: #E2E8F0;
}

QListWidget#SidebarNavList::item:selected {
    background-color: #0B4DCB;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#SidebarTrayButton {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    min-height: 34px;
}

QPushButton#SidebarTrayButton[collapsed="true"] {
    padding: 8px 0px;
    text-align: center;
    font-size: 13px;
}

QPushButton#SidebarTrayButton:hover {
    background-color: #1E293B;
    border-color: #334155;
    color: #F8FAFC;
}

QPushButton#SidebarAiStatusBadge {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 0px;
    min-height: 36px;
    max-height: 36px;
    height: 36px;
    text-align: left;
}

QPushButton#SidebarAiStatusBadge[collapsed="true"] {
    padding: 0px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    text-align: center;
}

QPushButton#SidebarAiStatusBadge:hover {
    background-color: #1E293B;
    border-color: #334155;
    color: #FFFFFF;
}

QLabel#SidebarAiStatusText {
    background-color: transparent;
    color: #E2E8F0;
    font-size: 11px;
    font-weight: 600;
    border: none;
    padding: 0px;
}

QPushButton#SidebarFolderButton {
    background-color: #0F172A;
    color: #CBD5E1;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 0px 10px;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
    min-height: 36px;
    max-height: 36px;
    height: 36px;
}

QPushButton#SidebarFolderButton[collapsed="true"] {
    padding: 0px;
    text-align: center;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QPushButton#SidebarFolderButton:hover {
    background-color: #1E293B;
    border-color: #334155;
    color: #FFFFFF;
}

QPushButton#SidebarTrayIconBtn {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 0px;
    margin: 0px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    width: 36px;
    height: 36px;
    text-align: center;
}

QPushButton#SidebarTrayIconBtn[collapsed="true"] {
    padding: 0px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}

QPushButton#SidebarTrayIconBtn:hover {
    background-color: #1E293B;
    border-color: #334155;
    color: #FFFFFF;
}

/* ----------------------------------------------------------------------------
   3. Workspace Canvas & Header
   ---------------------------------------------------------------------------- */
QFrame#WorkspaceContainer {
    background-color: #F8FAFC;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QFrame#TopHeaderBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

QLabel#PageHeaderTitle {
    color: #0F172A;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.015em;
}

QLabel#PageHeaderDesc {
    color: #475569;
    font-size: 12px;
    font-weight: 400;
}

QStackedWidget#MainStackedWidget {
    background-color: #F8FAFC;
}

/* ----------------------------------------------------------------------------
   4. Surface Cards (Instrument Cards, KPI Cards, Accordion, Banners)
   ---------------------------------------------------------------------------- */
HoverZoomCard,
QFrame[role="hoverZoomCard"],
QFrame[role="instrumentCard"],
QFrame[role="kpiCard"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QFrame[role="subCard"] {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QFrame[role="instrumentHeader"] {
    background-color: #F8FAFC;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
}

QFrame[role="podiumBar"] {
    background-color: #0B1329;
    border: 1px solid #1E293B;
    border-radius: 6px;
}

QLabel[role="podiumLabel"] {
    color: #F8FAFC;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
}

QFrame[role="seatCell"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
}

QFrame[role="seatCell"]:hover {
    background-color: #EFF6FF;
    border: 1px solid #0B4DCB;
}

QLabel[role="seatCode"] {
    color: #475569;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 10px;
    font-weight: 500;
}

QLabel[role="seatName"] {
    color: #0F172A;
    font-size: 12px;
    font-weight: 600;
}

QLabel#HoverCardTitle,
QLabel[role="cardTitle"] {
    color: #0F172A;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 2px 0px;
}

QLabel[role="cardSubtitle"] {
    color: #475569;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 11px;
    font-weight: 500;
}

/* KPI Typography */
QLabel[role="kpiLabel"] {
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
}

QLabel[role="kpiSubLabel"] {
    color: #475569;
    font-size: 12px;
    font-weight: 600;
}

QLabel[role="kpiValue"] {
    color: #0F172A;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 24px;
    font-weight: 700;
}

QLabel[role="kpiValuePrimary"] {
    color: #0B4DCB;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 24px;
    font-weight: 700;
}

QLabel[role="kpiValueDanger"] {
    color: #DC2626;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 24px;
    font-weight: 700;
}

QLabel[role="kpiUnit"] {
    color: #475569;
    font-size: 12px;
    font-weight: 500;
}

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    margin-top: 10px;
    padding: 16px 14px 14px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #0F172A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 2px 8px;
    background-color: #FFFFFF;
    border-radius: 4px;
    color: #0F172A;
    font-weight: 600;
}

QPushButton#CardMaxButton, QPushButton[role="cardMax"] {
    background-color: #F8FAFC;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 500;
    min-height: 24px;
}

QPushButton#CardMaxButton:hover, QPushButton[role="cardMax"]:hover {
    background-color: #EFF6FF;
    color: #0B4DCB;
    border-color: #BFDBFE;
}

QPushButton#CardMaxButton:checked, QPushButton[role="cardMax"]:checked {
    background-color: #EFF6FF;
    color: #0B4DCB;
    border-color: #0B4DCB;
    font-weight: 600;
}

/* Banners & Status Callouts */
QLabel[role="infoBanner"] {
    background-color: #EFF6FF;
    color: #00389C;
    border: 1px solid #BFDBFE;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 500;
}

QLabel[role="statusBanner"] {
    background-color: #F8FAFC;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 500;
}

QLabel[role="mutedText"] {
    color: #475569;
    font-size: 12px;
}

QLabel[role="codeMeta"] {
    color: #475569;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

/* Stitch 3-Stage Stepper & Status Chips */
QFrame[role="stepperBar"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QFrame[role="stageBox"] {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QFrame[role="stageBoxActive"] {
    background-color: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 8px;
}

QFrame[role="stageBoxDone"] {
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
    border-radius: 8px;
}

QLabel[role="stageNumber"] {
    background-color: #EFF6FF;
    color: #0B4DCB;
    border: 1px solid #BFDBFE;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
}

QLabel[role="stageTitle"] {
    color: #0F172A;
    font-size: 13px;
    font-weight: 600;
}

QLabel[role="fieldLabel"] {
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0px 0px 2px 2px;
}

QLabel[role="engineBadge"] {
    background-color: #F8FAFC;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
}

QLabel[role="stageBadge"],
QLabel[role="badgeNeutral"] {
    background-color: #F1F5F9;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="stageBadgeActive"] {
    background-color: #0B4DCB;
    color: #FFFFFF;
    border: 1px solid #093CA3;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="stageBadgeDone"],
QLabel[role="badgeSuccess"] {
    background-color: #DCFCE7;
    color: #15803D;
    border: 1px solid #86EFAC;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="badgePrimary"] {
    background-color: #E0F2FE;
    color: #0369A1;
    border: 1px solid #7DD3FC;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="badgeWarning"] {
    background-color: #FEF3C7;
    color: #B45309;
    border: 1px solid #FCD34D;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="badgeDanger"] {
    background-color: #FEE2E2;
    color: #B91C1C;
    border: 1px solid #FCA5A5;
    border-radius: 9px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* ----------------------------------------------------------------------------
   5. Sub-Tabs (QTabWidget)
   ---------------------------------------------------------------------------- */
QTabWidget::pane {
    background-color: transparent;
    border: none;
    margin-top: 4px;
}

QTabBar::tab {
    background-color: #F1F5F9;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 7px 14px;
    margin-right: 4px;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: #E2E8F0;
    color: #0F172A;
}

QTabBar::tab:selected {
    background-color: #0B4DCB;
    border-color: #093CA3;
    color: #FFFFFF;
    font-weight: 600;
}

/* ----------------------------------------------------------------------------
   6. Buttons & Interactive Controls (Primary Blue / Dark Action / White Outline)
   ---------------------------------------------------------------------------- */
/* White Outline / Default Button */
QPushButton,
QPushButton[role="subtle"],
QPushButton[role="outline"] {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    min-height: 24px;
}

QPushButton:hover,
QPushButton[role="subtle"]:hover,
QPushButton[role="outline"]:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
    color: #0F172A;
}

QPushButton:pressed,
QPushButton[role="subtle"]:pressed,
QPushButton[role="outline"]:pressed {
    background-color: #F1F5F9;
}

QPushButton:disabled,
QPushButton[role="subtle"]:disabled,
QPushButton[role="outline"]:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

/* Primary Blue Action Button (#0B4DCB) */
QPushButton[role="primary"] {
    background-color: #0B4DCB;
    color: #FFFFFF;
    border: 1px solid #093CA3;
    border-radius: 6px;
    font-weight: 600;
    padding: 5px 14px;
}

QPushButton[role="primary"]:hover {
    background-color: #0052CC;
    border-color: #00389C;
}

QPushButton[role="primary"]:pressed {
    background-color: #093CA3;
}

QPushButton[role="primary"]:disabled {
    background-color: #93C5FD;
    border-color: #93C5FD;
    color: #FFFFFF;
}

/* Dark Action Button (#0F172A) */
QPushButton[role="darkAction"],
QPushButton[role="slate"] {
    background-color: #0F172A;
    color: #FFFFFF;
    border: 1px solid #0F172A;
    border-radius: 6px;
    font-weight: 600;
    padding: 5px 14px;
}

QPushButton[role="darkAction"]:hover,
QPushButton[role="slate"]:hover {
    background-color: #1E293B;
    border-color: #1E293B;
}

QPushButton[role="darkAction"]:pressed,
QPushButton[role="slate"]:pressed {
    background-color: #0B1329;
}

QPushButton[role="darkAction"]:disabled,
QPushButton[role="slate"]:disabled {
    background-color: #CBD5E1;
    border-color: #CBD5E1;
    color: #FFFFFF;
}

/* Secondary Surface Button */
QPushButton[role="secondary"] {
    background-color: #F1F5F9;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="secondary"]:hover {
    background-color: #E2E8F0;
    border-color: #94A3B8;
    color: #0F172A;
}

QPushButton[role="secondary"]:pressed {
    background-color: #CBD5E1;
    color: #0F172A;
}

/* Teal / Tertiary Action Button (#006242) */
QPushButton[role="teal"] {
    background-color: #006242;
    color: #FFFFFF;
    border: 1px solid #005236;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="teal"]:hover {
    background-color: #007D55;
    border-color: #006242;
}

/* Success Button (#10B981) */
QPushButton[role="success"] {
    background-color: #10B981;
    color: #FFFFFF;
    border: 1px solid #059669;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="success"]:hover {
    background-color: #059669;
    border-color: #047857;
}

QPushButton[role="success"]:pressed {
    background-color: #047857;
}

/* Danger / Stop Button (#DC2626 or Outline) */
QPushButton[role="danger"] {
    background-color: #FFFFFF;
    color: #DC2626;
    border: 1px solid #FECACA;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="danger"]:hover {
    background-color: #FEF2F2;
    border-color: #F87171;
}

QPushButton[role="danger"]:pressed {
    background-color: #FEE2E2;
}

QPushButton[role="dangerSolid"] {
    background-color: #DC2626;
    color: #FFFFFF;
    border: 1px solid #B91C1C;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="dangerSolid"]:hover {
    background-color: #B91C1C;
}

/* Warning / Undo Outline Button */
QPushButton[role="warningOutline"] {
    background-color: #FFFBEB;
    color: #92400E;
    border: 1px solid #FDE68A;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="warningOutline"]:hover {
    background-color: #FEF3C7;
    border-color: #F59E0B;
}

/* Tag / Keyword Chip Button */
QPushButton[role="tagChip"] {
    background-color: #EFF6FF;
    color: #0B4DCB;
    border: 1px solid #BFDBFE;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
    min-height: 22px;
}

QPushButton[role="tagChip"]:hover {
    background-color: #DBEAFE;
    border-color: #0B4DCB;
}

/* ----------------------------------------------------------------------------
   7. Form Inputs (QLineEdit, QComboBox, QSpinBox, QDateEdit, QTimeEdit, QTreeWidget)
   ---------------------------------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 32px;
    height: 32px;
    font-size: 13px;
    selection-background-color: #EFF6FF;
    selection-color: #0B4DCB;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover {
    border-color: #94A3B8;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border: 1.5px solid #0B4DCB;
    background-color: #FFFFFF;
    color: #0F172A;
}

QLineEdit:read-only, QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QDateEdit:disabled, QTimeEdit:disabled, QDateTimeEdit:disabled {
    background-color: #F8FAFC;
    color: #64748B;
    border-color: #E2E8F0;
}

QComboBox::drop-down, QDateEdit::drop-down, QTimeEdit::drop-down, QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #E2E8F0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #F8FAFC;
}

QComboBox::drop-down:hover, QDateEdit::drop-down:hover, QTimeEdit::drop-down:hover, QDateTimeEdit::drop-down:hover {
    background-color: #EFF6FF;
}

QComboBox::down-arrow, QDateEdit::down-arrow, QTimeEdit::down-arrow, QDateTimeEdit::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #64748B;
    margin-right: 1px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button, QDateEdit::up-button, QTimeEdit::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    background-color: #F8FAFC;
    border-top-right-radius: 5px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button, QDateEdit::down-button, QTimeEdit::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border-left: 1px solid #E2E8F0;
    background-color: #F8FAFC;
    border-bottom-right-radius: 5px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QTimeEdit::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover, QTimeEdit::down-button:hover {
    background-color: #EFF6FF;
}

QCalendarWidget {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
}

QCalendarWidget QWidget {
    background-color: #FFFFFF;
    color: #0F172A;
    alternate-background-color: #F8FAFC;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #0F172A;
    font-weight: 700;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: #E2E8F0;
    color: #1E293B;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
}

QCalendarWidget QSpinBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #FFFFFF;
    color: #0F172A;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    outline: 0;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #CBD5E1;
}

QComboBox QAbstractItemView {
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    background-color: #FFFFFF;
    selection-background-color: #EEF3FD;
    selection-color: #003EA8;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
}

QTextEdit, QListWidget, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #EEF3FD;
    selection-color: #003EA8;
}

QTextEdit:focus, QListWidget:focus, QTreeWidget:focus {
    border: 1px solid #2563EB;
}

QTreeWidget::item {
    padding: 5px 6px;
    border-radius: 4px;
}

QTreeWidget::item:hover {
    background-color: #F8FAFC;
}

QTreeWidget::item:selected {
    background-color: #EEF3FD;
    color: #004AC6;
    font-weight: 600;
}

/* Checkbox (Square 14px look) */
QCheckBox {
    spacing: 6px;
    color: #0F172A;
    font-size: 12px;
    font-weight: 500;
    min-height: 24px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1.5px solid #94A3B8;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #0B4DCB;
}

QCheckBox::indicator:checked {
    background-color: #0B4DCB;
    border-color: #0B4DCB;
    image: none;
}

/* ----------------------------------------------------------------------------
   8. Data Table (Instrument-Grade Desktop Grid — DESIGN.md 36px Header)
   ---------------------------------------------------------------------------- */
QTableWidget,
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #E2E8F0;
    selection-background-color: #EFF6FF;
    selection-color: #0B4DCB;
}

QTableWidget::item,
QTableView::item {
    padding: 6px 10px;
    border-bottom: 1px solid #E2E8F0;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #F1F5F9;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #EFF6FF;
    color: #0B4DCB;
}

QHeaderView {
    background-color: #F8FAFC;
    border: none;
    border-bottom: 1px solid #CBD5E1;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    min-height: 36px;
    height: 36px;
    border: none;
    border-bottom: 1px solid #CBD5E1;
    border-right: 1px solid #E2E8F0;
    padding: 0px 10px;
}

QTableCornerButton::section {
    background-color: #F8FAFC;
    border: none;
    border-bottom: 1px solid #CBD5E1;
    border-right: 1px solid #E2E8F0;
}

/* Splitter Handle */
QSplitter::handle {
    background-color: #E2E8F0;
    border-radius: 2px;
}

QSplitter::handle:horizontal {
    width: 5px;
    margin: 4px 2px;
}

QSplitter::handle:vertical {
    height: 5px;
    margin: 2px 4px;
}

QSplitter::handle:hover {
    background-color: #0B4DCB;
}

/* ----------------------------------------------------------------------------
   9. Bottom Status Bar & Terminal Log Drawers
   ---------------------------------------------------------------------------- */
QFrame#BottomStatusContainer {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
}

QLabel#StatusTaskBadge {
    background-color: #F1F5F9;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#StatusSingleLineLog {
    color: #475569;
    font-size: 12px;
    padding: 0 6px;
}

QProgressBar#ModernProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
    text-align: center;
}

QProgressBar#ModernProgressBar::chunk {
    background-color: #0B4DCB;
    border-radius: 4px;
}

QFrame#LogConsoleDrawer {
    background-color: #0B1329;
    border-top: 1px solid #1E293B;
}

QTextEdit#DarkLogConsole,
QTextEdit[role="terminalLog"] {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 8px 10px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

/* ----------------------------------------------------------------------------
   10. Modals & Dialogs
   ---------------------------------------------------------------------------- */
QDialog#ManualLlmModal,
QDialog#BatchManualPromptModal,
QDialog#PromptEditModal,
QDialog#DocxSchemaCreateModal,
QDialog#RuleEditModal {
    background-color: #F8F9FF;
}

QFrame#ModalHeaderCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QTextEdit#PromptCodeBox {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 10px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

QTextEdit#WebAiInputBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
}

QTextEdit#WebAiInputBox:focus {
    border: 1px solid #004AC6;
}

QTextEdit#ParsedPreviewBox {
    background-color: #F8FAFC;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 10px;
    font-size: 12px;
}

/* ----------------------------------------------------------------------------
   11. Scrollbars (Minimal Desktop Style)
   ---------------------------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ----------------------------------------------------------------------------
   12. Right AI Execution Dock (3-Column Slate Workstation) & Target Highlights
   ---------------------------------------------------------------------------- */
QPushButton#AiDockToggleBtn {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#AiDockToggleBtn:hover {
    background-color: #EFF6FF;
    border-color: #0B4DCB;
    color: #0B4DCB;
}

QPushButton#AiDockToggleBtn:checked {
    background-color: #0B4DCB;
    color: #FFFFFF;
    border: 1px solid #093CA3;
}

QPushButton#AiDockToggleBtn:checked:hover {
    background-color: #0052CC;
    border-color: #00389C;
}

QFrame#AiExecutionDock,
QFrame#AiDockPanelRoot {
    background-color: #FFFFFF;
    border-left: 1px solid #E2E8F0;
}

QFrame#AiDockTargetHeader {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QLabel[role="dockSectionLabel"] {
    color: #0B4DCB;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
}

QLabel#ActiveTargetDisplayBox {
    background-color: #EFF6FF;
    color: #0F172A;
    border: 1px solid #BFDBFE;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton[role="lockToggleBtn"] {
    background-color: #FFFFFF;
    color: #475569;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton[role="lockToggleBtn"]:hover {
    border-color: #0B4DCB;
    color: #0B4DCB;
}

QPushButton[role="lockToggleBtn"]:checked {
    background-color: #FEF3C7;
    color: #B45309;
    border: 1px solid #F59E0B;
}

QFrame#AiDockSegmentFrame {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QPushButton[role="segmentBtn"] {
    background-color: transparent;
    color: #475569;
    border: none;
    border-radius: 6px;
    padding: 0px 6px;
    font-size: 11.5px;
    font-weight: 600;
    min-height: 32px;
    max-height: 32px;
}

QPushButton[role="segmentBtn"]:hover {
    color: #0F172A;
    background-color: #E2E8F0;
}

QPushButton[role="segmentBtn"]:checked {
    background-color: #0B4DCB;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton[role="webAiChip"] {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 3px 6px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton[role="webAiChip"]:hover {
    border-color: #0B4DCB;
    color: #0B4DCB;
    background-color: #EFF6FF;
}

QPushButton[role="webAiChip"]:checked {
    background-color: #0B4DCB;
    color: #FFFFFF;
    border: 1px solid #093CA3;
}

QFrame#AiDockFooter {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

HoverZoomCard[aiTargetSelected="true"],
QFrame[role="hoverZoomCard"][aiTargetSelected="true"] {
    border: 1.5px solid #0B4DCB;
    background-color: #FFFFFF;
}

QLabel#AiTargetSelectedBadge {
    background-color: #E0F2FE;
    color: #0369A1;
    border: 1px solid #7DD3FC;
    border-radius: 10px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 700;
}

/* 2단계 헤더 활성 모드 배지 & 아코디언 설명 패널 */
QPushButton#AggModeBadge {
    border-radius: 11px;
    padding: 3px 11px;
    font-size: 11px;
    font-weight: 700;
    min-height: 24px;
    max-height: 26px;
}

QPushButton#AggModeBadge[aggMode="record"] {
    background-color: #ECFDF5;
    color: #047857;
    border: 1px solid #6EE7B7;
}

QPushButton#AggModeBadge[aggMode="record"]:hover {
    background-color: #D1FAE5;
    color: #065F46;
    border: 1px solid #34D399;
}

QPushButton#AggModeBadge[aggMode="record"]:checked {
    background-color: #059669;
    color: #FFFFFF;
    border: 1px solid #047857;
}

QPushButton#AggModeBadge[aggMode="record"]:checked:hover {
    background-color: #047857;
    color: #FFFFFF;
    border: 1px solid #065F46;
}

QPushButton#AggModeBadge[aggMode="grading"] {
    background-color: #FEF3C7;
    color: #B45309;
    border: 1px solid #FCD34D;
}

QPushButton#AggModeBadge[aggMode="grading"]:hover {
    background-color: #FDE68A;
    color: #92400E;
    border: 1px solid #F59E0B;
}

QPushButton#AggModeBadge[aggMode="grading"]:checked {
    background-color: #D97706;
    color: #FFFFFF;
    border: 1px solid #B45309;
}

QPushButton#AggModeBadge[aggMode="grading"]:checked:hover {
    background-color: #B45309;
    color: #FFFFFF;
    border: 1px solid #92400E;
}

QFrame#ModeExplainAccordion {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QLabel#ModeExplainSummaryLabel {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 8px 10px;
    color: #0F172A;
    font-size: 12px;
}

QLabel#ModeExplainRulesLabel {
    background-color: transparent;
    border: none;
    padding: 2px 4px;
    color: #334155;
    font-size: 12px;
}

/* QCalendarWidget Light Slate Surface (다크모드 팔레트 간섭 방지) */
QCalendarWidget {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
}
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
    min-height: 36px;
}
QCalendarWidget QToolButton {
    color: #0F172A;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-weight: 700;
    font-size: 13px;
}
QCalendarWidget QToolButton:hover {
    background-color: #E2E8F0;
}
QCalendarWidget QMenu {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
}
QCalendarWidget QSpinBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 2px 6px;
}
QCalendarWidget QAbstractItemView:enabled {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #0F172A;
    selection-background-color: #EFF6FF;
    selection-color: #0F172A;
    outline: 0;
    font-size: 13px;
}
QCalendarWidget QAbstractItemView:disabled {
    color: #94A3B8;
}
QCalendarWidget QTableView#qt_calendar_calendarview {
    border: none;
    border-radius: 0px;
    gridline-color: #E2E8F0;
}
QCalendarWidget QTableView#qt_calendar_calendarview::item {
    padding: 2px 4px;
    border-bottom: none;
}
QCalendarWidget QHeaderView::section {
    min-height: 24px;
    height: 24px;
    padding: 2px 4px;
    font-size: 11px;
    border-right: none;
}

/* ----------------------------------------------------------------------------
   13. Calendar & Todo Tab (Google Calendar & Tasks Style)
   ---------------------------------------------------------------------------- */
QFrame#MobileTaskAlertBanner {
    background-color: #EFF6FF;
    border: 1px solid #93C5FD;
    border-radius: 10px;
}

QFrame[role="mobileTaskCard"] {
    background-color: #FFFFFF;
    border: 1px solid #DBEAFE;
    border-radius: 10px;
}

QFrame[role="mobileTaskCard"]:hover {
    border-color: #2563EB;
    background-color: #F8FAFF;
}

QFrame[role="todoItemCard"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QFrame[role="todoItemCard"]:hover {
    border-color: #CBD5E1;
    background-color: #F8FAFC;
}

QFrame[role="todoItemCardUrgent"] {
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
    border-radius: 8px;
}

QFrame[role="calendarDayCell"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 0px;
}

QFrame[role="calendarDayCell"]:hover {
    background-color: #F8FAFC;
}

QFrame[role="calendarDayCellToday"] {
    background-color: #F0F7FF;
    border: 1.5px solid #2563EB;
    border-radius: 0px;
}

QFrame[role="calendarDayCellSelected"] {
    background-color: #EEF3FD;
    border: 1.5px solid #004AC6;
    border-radius: 0px;
}

QFrame[role="calendarDayCellMuted"] {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 0px;
}

QFrame#CalendarMonthGridFrame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

QDialog#ScheduleItemModal,
QDialog#ScheduleImportPreviewModal {
    background-color: #F8F9FF;
}

QPushButton#BtnBulkImportSchedule {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#BtnBulkImportSchedule:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
    color: #0F172A;
}

QPushButton#BtnCalendarSyncSheets {
    background-color: #0B4DCB;
    color: #FFFFFF;
    border: 1px solid #093CA3;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#BtnCalendarSyncSheets:hover {
    background-color: #0052CC;
    border-color: #00389C;
}

QPushButton#BtnNewCalendarItem {
    background-color: #0F172A;
    color: #FFFFFF;
    border: 1px solid #0F172A;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#BtnNewCalendarItem:hover {
    background-color: #1E293B;
    border-color: #1E293B;
}

QPushButton#BtnRefreshTasksPanel {
    background-color: #FFFFFF;
    color: #475569;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 0px;
    margin: 0px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#BtnRefreshTasksPanel:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
    color: #0F172A;
}

QLabel#MobileBannerIconBadge {
    background-color: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 8px;
    padding: 0px;
}

/* ----------------------------------------------------------------------------
   14. Dotted Dropzone & App-Wide File/Folder Drag & Drop Highlight
   ---------------------------------------------------------------------------- */
QFrame[role="dropZone"],
QFrame[role="dropzone"],
QWidget[role="dropZone"],
QWidget[role="dropzone"],
QPushButton[role="dropZone"],
QPushButton[role="dropzone"] {
    background-color: #F8FAFC;
    border: 1.5px dashed #CBD5E1;
    border-radius: 10px;
    color: #475569;
}

QFrame[role="dropZone"]:hover,
QFrame[role="dropzone"]:hover,
QWidget[role="dropZone"]:hover,
QWidget[role="dropzone"]:hover,
QPushButton[role="dropZone"]:hover,
QPushButton[role="dropzone"]:hover {
    background-color: #EFF6FF;
    border: 1.5px dashed #0B4DCB;
    color: #0B4DCB;
}

*[fileDragActive="true"] {
    border: 2px dashed #0B4DCB !important;
    background-color: #EFF6FF;
}


