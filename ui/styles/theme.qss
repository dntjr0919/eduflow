/* ============================================================================
   EduFlow Slate Workstation — Stitch Design System Theme
   File: ui/styles/theme.qss
   Stitch Tokens: Slate #0F172A (text/nav) · Canvas #F8F9FF (workspace)
                  Primary Blue #004AC6 / #2563EB · Border #E2E8F0
   Radius: controls 6px~8px · cards 10px~12px
   Architecture: High-contrast Dark Slate Navigation + Glare-reduced Workspace
   ============================================================================ */

* {
    font-family: "Inter", "Pretendard", "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 13px;
    outline: none;
}

/* ----------------------------------------------------------------------------
   1. Window & Dialog Backgrounds
   ---------------------------------------------------------------------------- */
QMainWindow {
    background-color: #0F172A;
}

QDialog {
    background-color: #F8F9FF;
    color: #0F172A;
}

QWidget {
    color: #0B1C30;
}

/* ----------------------------------------------------------------------------
   1-1. Floating Tooltips (Instrument Grade, Monoline Border)
   ---------------------------------------------------------------------------- */
QToolTip {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ----------------------------------------------------------------------------
   2. Dark Navigation Shell (Left Rail #0F172A)
   ---------------------------------------------------------------------------- */
QFrame#SidebarContainer {
    background-color: #0F172A;
    border-right: 1px solid #1E293B;
}

QPushButton#SidebarToggleBtn {
    background-color: #1E293B;
    color: #94A3B8;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
    font-size: 14px;
    font-weight: 600;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    text-align: center;
}

QPushButton#SidebarToggleBtn:hover {
    background-color: #004AC6;
    border-color: #2563EB;
    color: #FFFFFF;
}

QLabel#SidebarBrandTitle {
    color: #F8FAFC;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 2px 0px;
}

QLabel#SidebarBrandSubtitle {
    color: #64748B;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 0px 0px 6px 0px;
}

QLabel#SidebarSectionLabel {
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 8px 8px 4px 8px;
}

QListWidget#SidebarNavList {
    background-color: transparent;
    border: none;
    padding: 4px 0px;
    outline: none;
}

QListWidget#SidebarNavList::item {
    background-color: transparent;
    color: #94A3B8;
    border-radius: 8px;
    padding: 9px 12px;
    margin-bottom: 2px;
    font-size: 13px;
    font-weight: 500;
}

QListWidget#SidebarNavList[collapsed="true"] {
    padding: 4px 0px;
}

QListWidget#SidebarNavList[collapsed="true"]::item {
    padding: 9px 0px;
    font-size: 13px;
    text-align: center;
}

QListWidget#SidebarNavList::item:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: #F8FAFC;
}

QListWidget#SidebarNavList::item:selected {
    background-color: #004AC6;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#SidebarTrayButton {
    background-color: #1E293B;
    color: #94A3B8;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    min-height: 34px;
}

QPushButton#SidebarTrayButton[collapsed="true"] {
    padding: 8px 0px;
    text-align: center;
    font-size: 13px;
}

QPushButton#SidebarTrayButton:hover {
    background-color: #334155;
    border-color: #475569;
    color: #F8FAFC;
}

/* ----------------------------------------------------------------------------
   3. Workspace Canvas & Header
   ---------------------------------------------------------------------------- */
QFrame#WorkspaceContainer {
    background-color: #F8F9FF;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QFrame#TopHeaderBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

QLabel#PageHeaderTitle {
    color: #0F172A;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
}

QLabel#PageHeaderDesc {
    color: #64748B;
    font-size: 12px;
    font-weight: 400;
}

QLabel#AiModeBadge {
    background-color: #EEF3FD;
    color: #003EA8;
    border: 1px solid #C7D7F5;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

QStackedWidget#MainStackedWidget {
    background-color: #F8F9FF;
}

/* ----------------------------------------------------------------------------
   4. Surface Cards (Instrument Cards, KPI Cards, Accordion, Banners)
   ---------------------------------------------------------------------------- */
HoverZoomCard,
QFrame[role="hoverZoomCard"],
QFrame[role="instrumentCard"],
QFrame[role="kpiCard"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QFrame[role="subCard"] {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QFrame[role="instrumentHeader"] {
    background-color: #F8FAFC;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
}

QFrame[role="podiumBar"] {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 6px;
}

QLabel[role="podiumLabel"] {
    color: #F8FAFC;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
}

QFrame[role="seatCell"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
}

QFrame[role="seatCell"]:hover {
    background-color: #EEF3FD;
    border: 1px solid #2563EB;
}

QLabel[role="seatCode"] {
    color: #64748B;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 10px;
    font-weight: 500;
}

QLabel[role="seatName"] {
    color: #0F172A;
    font-size: 12px;
    font-weight: 600;
}

QLabel#HoverCardTitle,
QLabel[role="cardTitle"] {
    color: #0F172A;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 2px 0px;
}

QLabel[role="cardSubtitle"] {
    color: #64748B;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 11px;
    font-weight: 500;
}

/* KPI Typography */
QLabel[role="kpiLabel"] {
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
}

QLabel[role="kpiSubLabel"] {
    color: #475569;
    font-size: 12px;
    font-weight: 600;
}

QLabel[role="kpiValue"] {
    color: #0B1C30;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 24px;
    font-weight: 700;
}

QLabel[role="kpiValuePrimary"] {
    color: #004AC6;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 24px;
    font-weight: 700;
}

QLabel[role="kpiValueDanger"] {
    color: #BA1A1A;
    font-family: "JetBrains Mono", "Inter", sans-serif;
    font-size: 24px;
    font-weight: 700;
}

QLabel[role="kpiUnit"] {
    color: #64748B;
    font-size: 12px;
    font-weight: 500;
}

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    margin-top: 10px;
    padding: 16px 14px 14px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #0F172A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 2px 8px;
    background-color: #FFFFFF;
    border-radius: 4px;
    color: #0F172A;
    font-weight: 600;
}

QPushButton#CardMaxButton, QPushButton[role="cardMax"] {
    background-color: #F8FAFC;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 500;
    min-height: 24px;
}

QPushButton#CardMaxButton:hover, QPushButton[role="cardMax"]:hover {
    background-color: #EEF3FD;
    color: #004AC6;
    border-color: #C7D7F5;
}

QPushButton#CardMaxButton:checked, QPushButton[role="cardMax"]:checked {
    background-color: #EEF3FD;
    color: #004AC6;
    border-color: #2563EB;
    font-weight: 600;
}

/* Banners & Status Callouts */
QLabel[role="infoBanner"] {
    background-color: #EEF3FD;
    color: #00338A;
    border: 1px solid #DDE7FA;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 500;
}

QLabel[role="mutedText"] {
    color: #64748B;
    font-size: 12px;
}

QLabel[role="codeMeta"] {
    color: #64748B;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

/* Stitch 3-Stage Stepper & Status Chips */
QFrame[role="stepperBar"] {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QFrame[role="stageBox"] {
    background-color: #F8F9FF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QFrame[role="stageBoxActive"] {
    background-color: #EEF3FD;
    border: 1px solid #C7D7F5;
    border-radius: 8px;
}

QFrame[role="stageBoxDone"] {
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
    border-radius: 8px;
}

QLabel[role="stageNumber"] {
    background-color: #EEF3FD;
    color: #004AC6;
    border: 1px solid #C7D7F5;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
}

QLabel[role="stageTitle"] {
    color: #0F172A;
    font-size: 13px;
    font-weight: 600;
}

QLabel[role="fieldLabel"] {
    color: #475569;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0px 0px 2px 2px;
}

QLabel[role="engineBadge"] {
    background-color: #F8F9FF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
}

QLabel[role="stageBadge"],
QLabel[role="badgeNeutral"] {
    background-color: #F1F5F9;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="stageBadgeActive"] {
    background-color: #004AC6;
    color: #FFFFFF;
    border: 1px solid #003EA8;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="stageBadgeDone"],
QLabel[role="badgeSuccess"] {
    background-color: #ECFDF5;
    color: #065F46;
    border: 1px solid #A7F3D0;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="badgePrimary"] {
    background-color: #EEF3FD;
    color: #004AC6;
    border: 1px solid #C7D7F5;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="badgeWarning"] {
    background-color: #FFFBEB;
    color: #92400E;
    border: 1px solid #FDE68A;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[role="badgeDanger"] {
    background-color: #FEF2F2;
    color: #991B1B;
    border: 1px solid #FECACA;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* ----------------------------------------------------------------------------
   5. Sub-Tabs (QTabWidget)
   ---------------------------------------------------------------------------- */
QTabWidget::pane {
    background-color: transparent;
    border: none;
    margin-top: 4px;
}

QTabBar::tab {
    background-color: #E2E8F0;
    color: #475569;
    border: none;
    border-radius: 6px;
    padding: 7px 14px;
    margin-right: 4px;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: #CBD5E1;
    color: #0F172A;
}

QTabBar::tab:selected {
    background-color: #004AC6;
    color: #FFFFFF;
    font-weight: 600;
}

/* ----------------------------------------------------------------------------
   6. Buttons & Interactive Controls (Precision Button Hierarchy)
   ---------------------------------------------------------------------------- */
/* Default / Subtle Button */
QPushButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
    color: #0F172A;
}

QPushButton:pressed {
    background-color: #F1F5F9;
}

QPushButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

/* Primary Action Button (#004AC6) */
QPushButton[role="primary"] {
    background-color: #004AC6;
    color: #FFFFFF;
    border: 1px solid #003EA8;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="primary"]:hover {
    background-color: #2563EB;
    border-color: #004AC6;
}

QPushButton[role="primary"]:pressed {
    background-color: #00338A;
}

QPushButton[role="primary"]:disabled {
    background-color: #9BB5E6;
    border-color: #9BB5E6;
    color: #FFFFFF;
}

/* Secondary Button */
QPushButton[role="secondary"] {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-weight: 500;
}

QPushButton[role="secondary"]:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
}

QPushButton[role="secondary"]:pressed {
    background-color: #F1F5F9;
}

/* Outline / Subtle Ghost Button */
QPushButton[role="outline"] {
    background-color: transparent;
    color: #475569;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-weight: 500;
}

QPushButton[role="outline"]:hover {
    background-color: #F1F5F9;
    color: #0F172A;
    border-color: #94A3B8;
}

/* Teal / Tertiary Action Button (#006242) */
QPushButton[role="teal"] {
    background-color: #006242;
    color: #FFFFFF;
    border: 1px solid #005236;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="teal"]:hover {
    background-color: #007D55;
    border-color: #006242;
}

/* Success Button (#10B981) */
QPushButton[role="success"] {
    background-color: #10B981;
    color: #FFFFFF;
    border: 1px solid #059669;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="success"]:hover {
    background-color: #059669;
    border-color: #047857;
}

QPushButton[role="success"]:pressed {
    background-color: #047857;
}

/* Danger / Stop Button (#DC2626 or Outline) */
QPushButton[role="danger"] {
    background-color: #FFFFFF;
    color: #DC2626;
    border: 1px solid #FECACA;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="danger"]:hover {
    background-color: #FEF2F2;
    border-color: #F87171;
}

QPushButton[role="danger"]:pressed {
    background-color: #FEE2E2;
}

QPushButton[role="dangerSolid"] {
    background-color: #DC2626;
    color: #FFFFFF;
    border: 1px solid #B91C1C;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="dangerSolid"]:hover {
    background-color: #B91C1C;
}

/* Warning / Undo Outline Button */
QPushButton[role="warningOutline"] {
    background-color: #FFFBEB;
    color: #92400E;
    border: 1px solid #FDE68A;
    border-radius: 6px;
    font-weight: 600;
}

QPushButton[role="warningOutline"]:hover {
    background-color: #FEF3C7;
    border-color: #F59E0B;
}

/* Slate Utility Button */
QPushButton[role="slate"] {
    background-color: #334155;
    color: #F8FAFC;
    border: 1px solid #475569;
    border-radius: 6px;
    font-weight: 500;
}

QPushButton[role="slate"]:hover {
    background-color: #475569;
}

/* Tag / Keyword Chip Button */
QPushButton[role="tagChip"] {
    background-color: #EEF3FD;
    color: #004AC6;
    border: 1px solid #C7D7F5;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
    min-height: 22px;
}

QPushButton[role="tagChip"]:hover {
    background-color: #DBE1FF;
    border-color: #2563EB;
}

/* ----------------------------------------------------------------------------
   7. Form Inputs (QLineEdit, QComboBox, QSpinBox, QTreeWidget)
   ---------------------------------------------------------------------------- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 32px;
    height: 32px;
    font-size: 13px;
    selection-background-color: #EEF3FD;
    selection-color: #003EA8;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border-color: #94A3B8;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #2563EB;
    background-color: #FFFFFF;
}

QLineEdit:read-only, QLineEdit:disabled {
    background-color: #F8FAFC;
    color: #64748B;
    border-color: #E2E8F0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #E2E8F0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #F8FAFC;
}

QComboBox::drop-down:hover {
    background-color: #F1F5F9;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #64748B;
    margin-right: 1px;
}

QComboBox QAbstractItemView {
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    background-color: #FFFFFF;
    selection-background-color: #EEF3FD;
    selection-color: #003EA8;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
}

QTextEdit, QListWidget, QTreeWidget {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #EEF3FD;
    selection-color: #003EA8;
}

QTextEdit:focus, QListWidget:focus, QTreeWidget:focus {
    border: 1px solid #2563EB;
}

QTreeWidget::item {
    padding: 5px 6px;
    border-radius: 4px;
}

QTreeWidget::item:hover {
    background-color: #F8FAFC;
}

QTreeWidget::item:selected {
    background-color: #EEF3FD;
    color: #004AC6;
    font-weight: 600;
}

/* Checkbox (Square 14px look) */
QCheckBox {
    spacing: 6px;
    color: #0F172A;
    font-size: 12px;
    font-weight: 500;
    min-height: 24px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1.5px solid #94A3B8;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #2563EB;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
    image: none;
}

/* ----------------------------------------------------------------------------
   8. Data Table (Instrument-Grade Desktop Grid)
   ---------------------------------------------------------------------------- */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #F1F5F9;
    selection-background-color: #EEF3FD;
    selection-color: #003EA8;
}

QTableWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid #F1F5F9;
}

QTableWidget::item:selected {
    background-color: #EEF3FD;
    color: #003EA8;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    min-height: 32px;
    height: 32px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-right: 1px solid #F1F5F9;
    padding: 0px 8px;
}

QTableCornerButton::section {
    background-color: #F8FAFC;
    border: none;
    border-bottom: 1px solid #E2E8F0;
}

/* Splitter Handle */
QSplitter::handle {
    background-color: #E2E8F0;
    border-radius: 2px;
}

QSplitter::handle:horizontal {
    width: 5px;
    margin: 4px 2px;
}

QSplitter::handle:vertical {
    height: 5px;
    margin: 2px 4px;
}

QSplitter::handle:hover {
    background-color: #004AC6;
}

/* ----------------------------------------------------------------------------
   9. Bottom Status Bar & Terminal Log Drawers
   ---------------------------------------------------------------------------- */
QFrame#BottomStatusContainer {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
}

QLabel#StatusTaskBadge {
    background-color: #F1F5F9;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#StatusSingleLineLog {
    color: #64748B;
    font-size: 12px;
    padding: 0 6px;
}

QProgressBar#ModernProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
    text-align: center;
}

QProgressBar#ModernProgressBar::chunk {
    background-color: #004AC6;
    border-radius: 4px;
}

QFrame#LogConsoleDrawer {
    background-color: #0F172A;
    border-top: 1px solid #1E293B;
}

QTextEdit#DarkLogConsole,
QTextEdit[role="terminalLog"] {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 8px 10px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

/* ----------------------------------------------------------------------------
   10. Modals & Dialogs
   ---------------------------------------------------------------------------- */
QDialog#ManualLlmModal, QDialog#RuleEditModal {
    background-color: #F8FAFC;
}

QFrame#ModalHeaderCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QTextEdit#PromptCodeBox {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 10px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}

QTextEdit#WebAiInputBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
}

QTextEdit#WebAiInputBox:focus {
    border: 1px solid #004AC6;
}

QTextEdit#ParsedPreviewBox {
    background-color: #F0FDF4;
    color: #14532D;
    border: 1px solid #BBF7D0;
    border-radius: 8px;
    padding: 10px;
    font-size: 12px;
}

/* ----------------------------------------------------------------------------
   11. Scrollbars (Minimal Desktop Style)
   ---------------------------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
