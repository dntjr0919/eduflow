<file path="run_generate_record.bat">
@echo off
chcp 65001 > nul
setlocal

cd /d "%~dp0"

cls
echo ============================================================
echo [과세특 생성 프로그램 실행]
echo ============================================================
echo.
echo 이 프로그램은 학생 응답을 바탕으로 과세특 초안을 생성합니다.
echo 실행 전에 필요한 항목을 자동으로 확인합니다.
echo.
echo [폴더 안내]
echo - input 폴더: 실제로 처리할 .xlsx 파일을 넣는 곳입니다.
echo - input_ignore 폴더: 지금은 처리하지 않을 파일을 잠시 보관하는 곳입니다.
echo - input_ignore 안의 파일은 실행 대상이 아닙니다.
echo - output 폴더: 생성 결과 엑셀 파일이 저장되는 곳입니다.
echo.

if not exist "generate_record.py" goto no_script
if not exist ".venv\Scripts\python.exe" goto no_venv
if not exist ".env" goto no_env
if not exist "input\" goto no_input_folder
dir /a-d /b "input\*.xlsx" > nul 2>&1 || goto no_excel_file
if not exist "output\" mkdir "output"
if not exist "output_ignore\" mkdir "output_ignore"
if errorlevel 1 goto output_create_fail

echo [1/8] 프로그램 파일 확인 완료
echo      - generate_record.py 파일이 있습니다.
echo.
echo [2/8] 가상환경 확인 완료
echo      - .venv 폴더가 있습니다.
echo      - 가상환경은 이 프로그램 전용 Python 실행 공간입니다.
echo.
echo [3/8] 환경설정 파일 확인 완료
echo      - .env 파일이 있습니다.
echo      - Gemini API 키를 이 파일에서 읽습니다.
echo.
echo [4/8] input 폴더 확인 완료
echo      - input 폴더가 있습니다.
echo.
echo [5/8] 입력 파일 확인 완료
echo      - input 폴더에 .xlsx 파일이 있습니다.
echo.
echo [6/8] output 폴더 확인 완료
echo      - 생성 결과 파일은 output 폴더에 저장됩니다.
echo.
echo [7/8] 가상환경 활성화 중...
call .\.venv\Scripts\activate.bat
if errorlevel 1 goto activate_fail
echo      - 완료되었습니다.
echo [8/8] 프로그램을 실행합니다.
echo ------------------------------------------------------------
echo 잠시 후 프롬프트 번호를 입력하는 화면이 나올 수 있습니다.
echo 그때는 키보드로 숫자를 입력한 뒤 Enter 를 누르세요.
echo.
echo 실행을 중간에 멈추고 싶을 때만 Ctrl + C 를 누르세요.
echo 프로그램 시작 직후나 참고자료를 읽는 중에는 잠시 기다려 주세요.
echo Ctrl + C 를 누르면 현재 작업이 중단될 수 있습니다.
echo 학생별 결과 저장 중이었다면, 저장된 부분까지는 유지될 수 있습니다.
echo **주의**
echo output 폴더: 이번 실행 결과 엑셀 파일이 저장되는 곳입니다.
echo output_ignore 폴더: 예전 결과 파일을 잠시 보관하는 곳입니다.
echo 같은 이름의 결과 파일이 output에 남아 있으면 이어쓰기 기준이 될 수 있습니다.
echo 한번 작업한 후에 결과물을 output_ignore 로 옮기거나, 다른 폴더로 옮겨야 이어쓰기가 정상 작동합니다.
echo ------------------------------------------------------------
echo.

.\.venv\Scripts\python.exe generate_record.py
if errorlevel 1 goto run_fail

echo.
echo ============================================================
echo 프로그램 실행이 끝났습니다.
echo **결과물을 다시 input 폴더에 넣고 다듬기나 요약하려면 생성된 .xlsx 파일의 생성된_과세특 열 제목을 다른걸로 바꾸면 됩니다.**
echo 창을 닫으려면 아무 키나 누르세요.
echo ============================================================
pause > nul
exit /b 0

:no_script
echo [오류] generate_record.py 파일을 찾을 수 없습니다.
echo.
echo 해결 방법:
echo 1. 이 배치 파일과 generate_record.py 가 같은 폴더에 있는지 확인하세요.
echo 2. 파일 이름이 바뀌지 않았는지 확인하세요.
echo.
echo 창을 닫으려면 아무 키나 누르세요.
pause > nul
exit /b 1

:no_venv
echo [오류] .venv 가상환경을 찾을 수 없습니다.
echo.
echo 해결 방법:
echo 1. 먼저 install.bat 을 더블클릭해서 실행하세요.
echo 2. 설치가 끝난 뒤 다시 run_generate_record.bat 를 실행하세요.
echo.
echo 창을 닫으려면 아무 키나 누르세요.
pause > nul
exit /b 1

:no_env
echo [오류] .env 파일을 찾을 수 없습니다.
echo.
echo .env 파일은 Gemini API 키를 저장하는 설정 파일입니다.
echo 이 파일이 없으면 AI 기능을 사용할 수 없습니다.
echo.
echo [만드는 방법 - VS Code 기준]
echo 1. 현재 프로젝트 폴더를 VS Code 로 엽니다.
echo 2. 왼쪽 파일 목록에서 [새 파일]을 누릅니다.
echo 3. 파일 이름을 정확히 .env 로 입력합니다.
echo 4. 파일 안에 아래 형식으로 한 줄 입력합니다.
echo.
echo    GEMINI_API_KEY=여기에본인API키입력
echo.
echo [중요]
echo - GEMINI_API_KEY 왼쪽 이름은 바꾸면 안 됩니다.
echo - = 오른쪽에 본인 API 키를 붙여넣으세요.
echo - 따옴표는 없이 저장하는 것을 추천합니다.
echo - 이 파일은 generate_record.py 와 같은 폴더에 있어야 합니다.
echo.
echo [예시]
echo GEMINI_API_KEY=AIzaSy........
echo.
echo .env 파일을 만든 뒤, 다시 run_generate_record.bat 를 실행하세요.
echo.
echo 창을 닫으려면 아무 키나 누르세요.
pause > nul
exit /b 1

:activate_fail
echo [오류] 가상환경 활성화에 실패했습니다.
echo.
echo 해결 방법:
echo 1. install.bat 을 다시 실행해 보세요.
echo 2. 그래도 안 되면 .venv 폴더를 삭제한 뒤 다시 설치하세요.
echo.
echo 창을 닫으려면 아무 키나 누르세요.
pause > nul
exit /b 1

:run_fail
echo.
echo [오류] 프로그램 실행 중 문제가 발생했습니다.
echo.
echo 확인할 것:
echo 1. 위쪽에 나온 오류 메시지를 읽어 보세요.
echo 2. .env 의 API 키가 맞는지 확인하세요.
echo 3. input 폴더 안에 .xlsx 파일이 있는지 확인하세요.
echo 4. output 결과 파일이 엑셀에서 열려 있으면 닫고 다시 실행하세요.
echo.
echo 창을 닫으려면 아무 키나 누르세요.
pause > nul
exit /b 1

:no_input_folder
echo [오류] input 폴더를 찾을 수 없습니다.
echo.
echo 해결 방법:
echo 1. 프로젝트 폴더 안에 input 폴더를 만드세요.
echo 2. 폴더 이름은 정확히 input 이어야 합니다.
